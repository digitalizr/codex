# Copy to production.env on the server; keep that file out of Git.
# HEARTH_IMAGE is managed by deployment as hearth:<full Git commit SHA>.
# The script verifies and loads the matching ARM64 image archive on the server.
HEARTH_PORT=3000

# false: only localhost:3000 is exposed. Connect through an SSH tunnel.
# true: the deployment script also starts Caddy's "edge" Compose profile.
HEARTH_EDGE_ENABLED=false

# Edge mode needs a domain pointed at this server and inbound TCP 80/443.
# Use the bare hostname without https://, a port or a path.
# APP_DOMAIN=groceries.example.com
BASIC_AUTH_USER=hearth

# Generate a bcrypt hash with an interactive prompt, keeping the password
# out of command arguments and shell history:
# docker run --rm -it caddy:2-alpine caddy hash-password --algorithm bcrypt
# Paste the result below INSIDE SINGLE QUOTES so Compose does not expand
# the bcrypt hash's dollar signs. Set this only when edge mode is enabled.
# BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_YOUR_COMPLETE_CADDY_HASH'

# Basic Auth protects the whole public app, including /api/health.
# It lives at the reverse proxy; household profiles still need no login.
